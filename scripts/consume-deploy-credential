#!/usr/bin/env bash
set -Eeuo pipefail
umask 077
name=${1:-github-api}
[[ $name == github-api && $# == 1 ]] || exit 64
uid=$(id -u)
state=${XDG_STATE_HOME:-$HOME/.local/state}
user=$(id -un)
for dir in "/run/dotfiles-deploy/$user" "$state/dotfiles-deploy"; do
  file=$dir/$name
  [[ -e $file || -L $file ]] || continue
  bad=0
  [[ ! -L $dir && -d $dir && $(stat -c %u "$dir") == "$uid" && $(stat -c %a "$dir") == 700 ]] || bad=1
  [[ ! -L $file && -f $file && $(stat -c %u "$file") == "$uid" && $(stat -c %a "$file") == 600 ]] || bad=1
  size=$(stat -c %s "$file" 2>/dev/null || echo 99999)
  age=$(( $(date +%s) - $(stat -c %Y "$file" 2>/dev/null || echo 0) ))
  (( size >= 20 && size <= 513 && age >= 0 && age <= 43200 )) || bad=1
  if (( bad )); then rm -f -- "$file"; continue; fi
  IFS= read -r token <"$file" || { rm -f -- "$file"; continue; }
  rm -f -- "$file"
  [[ ${#token} -ge 20 && ${#token} -le 512 && $token != *[$'\t\r\n ']* && $token =~ ^[A-Za-z0-9_][A-Za-z0-9_.-]+$ ]] || exit 1
  printf '%s\n' "$token"
  exit 0
done
exit 1
