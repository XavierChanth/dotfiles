# Media keys binds (using scripts)
bindcode --locked 160 exec wlogout
bindsym --locked XF86PowerOff exec wlogout
bindsym --locked XF86AudioMute exec $script/volume-mute
bindsym --locked XF86AudioLowerVolume exec $script/volume-down
bindsym --locked XF86AudioRaiseVolume exec $script/volume-up
bindsym --locked XF86AudioPrev exec $script/media-prev
bindsym --locked XF86AudioPlay exec $script/media-play-pause
bindsym --locked XF86AudioNext exec $script/media-next
bindsym --locked XF86MonBrightnessDown exec $script/brightness-down
bindsym --locked XF86MonBrightnessUp exec $script/brightness-up
# ALT_L+p = F9
# bindsym --locked XF86RFKILL # F10
# bindsym XF86AudioMedia # F12

# Screenshot keybinds (using scripts)
set $printscreen_mode 'printscreen (r:region, f:full, w:window)'

mode $printscreen_mode {
  bindsym r exec swaymsg 'mode "default"' && $script/screenshot-region
  bindsym f exec swaymsg 'mode "default"' && $script/screenshot-full
  bindsym w exec swaymsg 'mode "default"' && $script/screenshot-window

    bindsym Return mode "default"
    bindsym Escape mode "default"
}

bindsym Print mode $printscreen_mode
bindsym $hypr+2 exec $script/screenshot-region-view
bindsym $hypr+3 exec $script/screenshot-window
bindsym $hypr+4 exec $script/screenshot-region

