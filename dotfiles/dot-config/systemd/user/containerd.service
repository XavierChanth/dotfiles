[Unit]
Description=containerd (Rootless)
Requires=dbus.socket

[Service]
Environment=PATH=/bin:/sbin:/usr/sbin:/home/chant/.local/bin:/home/chant/.dotnet/tools:/home/chant/.cargo/bin:/home/chant/go/bin:/Users/chant/Library/Android/sdk/cmdline-tools/latest/bin:/home/chant/.pub-cache/bin:/home/chant/.local/dev/flutter/bin:/home/chant/.local/dev/flutter/bin/cache/dart-sdk/bin::/home/chant/.cargo/bin:/bin:/usr/bin:/usr/local/sbin:/usr/local/bin:/usr/share/dotnet:/home/chant/.dotnet/tools:/var/lib/flatpak/exports/bin:/usr/bin/site_perl:/usr/bin/vendor_perl:/usr/bin/core_perl:/opt/rocm/bin:/usr/NX/bin
Environment=CONTAINERD_ROOTLESS_ROOTLESSKIT_FLAGS=
ExecStart=/bin/containerd-rootless.sh
ExecReload=/bin/kill -s HUP $MAINPID
TimeoutSec=0
RestartSec=2
Restart=always
StartLimitBurst=3
StartLimitInterval=60s
LimitNOFILE=infinity
LimitNPROC=infinity
LimitCORE=infinity
TasksMax=infinity
Delegate=yes
Type=simple
KillMode=mixed

[Install]
WantedBy=default.target
