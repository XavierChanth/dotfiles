// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "bindings": {
      "ctrl-h": [
        "workspace::ActivatePaneInDirection",
        "Left"
      ],
      "ctrl-l": [
        "workspace::ActivatePaneInDirection",
        "Right"
      ],
      "ctrl-k": [
        "workspace::ActivatePaneInDirection",
        "Up"
      ],
      "ctrl-j": [
        "workspace::ActivatePaneInDirection",
        "Down"
      ]
    }
  },
  {
    "context": "VimControl && !menu",
    "bindings": {
      "cmd-j": [
        "workspace::SendKeystrokes",
        "5 j"
      ],
      "cmd-k": [
        "workspace::SendKeystrokes",
        "5 k"
      ],
      "space c a": "editor::ToggleCodeActions"
    }
  },
  {
    "context": "TabSwitcher",
    "bindings": {
      "j": "menu::SelectNext",
      "k": "menu::SelectPrev",
      "ctrl-d": "tab_switcher::CloseSelectedItem"
    }
  },
  {
    "context": "vim_mode == normal || EmptyPane || SharedScreen",
    "bindings": {
      "space space": "file_finder::Toggle",
      "space g b": "editor::ToggleGitBlameInline",
      "space j": "tab_switcher::Toggle",
      "space e": "project_panel::ToggleFocus",
      "space b n": "workspace::NewFile",
      // "space b b" :"",
      "space b d": "pane::CloseActiveItem",
      "space b o": "pane::CloseInactiveItems",
      "space b r": "workspace::ReloadActiveItem",
      "space \\": "pane::SplitRight",
      "space -": "pane::SplitDown"
    }
  },
  {
    "bindings": {
      "ctrl--": "workspace::ToggleBottomDock"
    }
  },
  {
    "context": "ProjectPanel",
    "bindings": {
      "space e": "workspace::ToggleLeftDock"
    }
  },
  {
    "context": "vim_mode == normal && !VimWaiting && !menu",
    "bindings": {
      "space c r": "editor::Rename",
      "g d": "editor::GoToDefinition",
      "g D": "editor::GoToDeclaration",
      "g I": "editor::GoToImplementation",
      "g y": "editor::GoToTypeDefinition",
      "g r": "editor::FindAllReferences",
      "] d": "editor::GoToDiagnostic",
      "[ d": "editor::GoToPrevDiagnostic",
      "space s g": "workspace::NewSearch",
      "space s s": "outline::Toggle",
      "space s S": "project_symbols::Toggle",
      "space x x": "diagnostics::Deploy",
      "space q q": "zed::Quit"
    }
  },
  {
    "context": "vim_mode == visual && !menu",
    "bindings": {
      "<": [
        "workspace::SendKeystrokes",
        "g < g v"
      ],
      ">": [
        "workspace::SendKeystrokes",
        "g > g v"
      ],
      "g <": "vim::Outdent",
      "g >": "vim::Indent"
    }
  },
  {
    "context": "vim_mode == insert && !menu",
    "bindings": {
      "ctrl-n": "editor::ShowCompletions",
      "ctrl-p": "editor::ShowCompletions"
    }
  },
  {
    "context": "vim_mode == insert && menu",
    "bindings": {
      "tab": null,
      "shift-tab": null
    }
  }
]
