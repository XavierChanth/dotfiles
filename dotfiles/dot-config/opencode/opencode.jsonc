{
  "$schema": "https://opencode.ai/config.json",
  "theme": "tokyonight",
  "default_agent": "plan",
  // "model": "openai/gpt-5.2-codex",
  // "model": "openai/gpt-5.2",
  // "model": "opencode/claude-opus-4-5",
