{
  "$schema": "https://opencode.ai/config.json",
  "theme": "tokyonight",

  // If I'm doing a plan-first approach, I prefer to reach for codex
  "default_agent": "plan",

  "model": "openai/gpt-5.3-codex",
  "agent": {
    "build": {
      "model": "openai/gpt-5.3-codex",
      "reasoningEffort": "medium",
    },
    "plan": {
      "model": "openai/gpt-5.3-codex",
      "reasoningEffort": "high",
    },

    // Anything cheap and fast is good for session models.
    "title": { "model": "zai-coding-plan/glm-4.7-flash" }
  },
  "keybinds": {
    "model_cycle_favorite": "ctrl+n",
    "messages_half_page_up": "ctrl+u",
    "messages_half_page_down": "ctrl+d",
    "editor_open": "ctrl+e",
  },
  "permission": {
    "bash": {
      "rm *": "ask",
    }
  },
}
