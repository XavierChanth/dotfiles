{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3:30b": {},
        "qwen3:4b": {},
        "mistral:7b": {},
      }
    },
  },
  "lsp": {
    "dartls": {
      "command": ["dart", "language-server", "--protocol=lsp"],
      "extensions": [".dart"],
    }
  },
  "permission": {
    "bash": "ask",
    "edit": "allow",
    "webfetch": "ask",
  },
  "theme": "system",
  "keybinds": {
    "leader": "ctrl+g",
    "app_help": "<leader>h",
    "app_exit": "ctrl+c,<leader>q",
    "editor_open": "<leader>e",
    "theme_list": "none",
    "project_init": "none",
    "tool_details": "none",
    "thinking_blocks": "none",
    "session_export": "<leader>x",
    "session_new": "<leader>n",
    "session_list": "<leader>l",
    "session_share": "none",
    "session_unshare": "none",
    "session_interrupt": "esc",
    "session_compact": "none",
    "session_child_cycle": "none",
    "session_child_cycle_reverse": "none",
    "messages_page_up": "ctrl+b",
    "messages_page_down": "ctrl+f",
    "messages_half_page_up": "ctrl+alt+u",
    "messages_half_page_down": "ctrl+alt+d",
    "messages_first": "ctrl+g",
    "messages_last": "ctrl+alt+g",
    "messages_copy": "<leader>y",
    "messages_undo": "<leader>u",
    "messages_redo": "<leader>r",
    "model_list": "<leader>m",
    "model_cycle_recent": "none",
    "model_cycle_recent_reverse": "none",
    "agent_list": "none",
    "agent_cycle": "tab",
    "agent_cycle_reverse": "none",
    "input_clear": "ctrl+c",
    "input_paste": "ctrl+v",
    "input_submit": "enter",
    "input_newline": "shift+enter,ctrl+o"
  }
}
