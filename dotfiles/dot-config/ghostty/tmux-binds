# super numbers to tmux window
keybind = super+physical:one=text:\x001
keybind = super+physical:two=text:\x002
keybind = super+physical:three=text:\x003
keybind = super+physical:four=text:\x004
keybind = super+physical:five=text:\x005
keybind = super+physical:six=text:\x006
keybind = super+physical:seven=text:\x007
keybind = super+physical:eight=text:\x008
keybind = super+physical:nine=text:\x009

# hyper 1:1 mappings
keybind =	super+ctrl+shift+alt+a=text:\x00a
keybind =	super+ctrl+shift+alt+s=text:\x00s
keybind =	super+ctrl+shift+alt+d=text:\x00d
keybind =	super+ctrl+shift+alt+r=text:\x00r
keybind =	super+ctrl+shift+alt+c=text:\x00c
keybind =	super+ctrl+shift+alt+p=text:\x00p
keybind =	super+ctrl+shift+alt+l=text:\x00l
keybind =	super+ctrl+shift+alt+v=text:\x00v
keybind =	super+ctrl+shift+alt+x=text:\x00x
keybind =	super+ctrl+shift+alt+w=text:\x00w
keybind =	super+ctrl+shift+alt+z=text:\x00z
keybind =	super+ctrl+shift+alt+f=text:\x00f
keybind =	super+ctrl+shift+alt+g=text:\x00g
keybind =	super+ctrl+shift+alt+n=text:\x00n
keybind =	super+ctrl+shift+alt+p=text:\x00p

# hyper+q to prefix+d
keybind =	super+ctrl+shift+alt+q=text:\x00d
