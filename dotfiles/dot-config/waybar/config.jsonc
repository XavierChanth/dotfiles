// -*- mode: jsonc -*-
{
  "layer": "top", // Waybar at top layer
  "position": "top", // Waybar position (top|bottom|left|right)
  "height": 24, // Waybar height (to be removed for auto height)
  // "width": 1280, // Waybar width
  "spacing": 4, // Gaps between modules (4px)
  // Choose the order of the modules
  "modules-left": ["sway/workspaces", "hyprland/workspaces", "sway/window", "hyprland/window"],
  "modules-center": ["clock", "custom/spacer", "custom/pomodoro"],
  "modules-right": [
    "group/gtray",
    "group/gmonitor",
    "group/gcontrol",
    "group/gurgent",
  ],

  "group/gtray": {
    "orientation": "horizontal",
    "drawer": {
      "click-to-reveal": true,
      "transition-left-to-right": false,
      "children-class": "drawer",
    },
    "modules": ["custom/tray", "tray"],
  },

  "group/gmonitor": {
    "orientation": "horizontal",
    "drawer": {
      "click-to-reveal": true,
      "transition-left-to-right": false,
      "children-class": "drawer",
    },
    "modules": [
      "custom/monitor",
      "memory",
      "cpu",
      "temperature",
      "power-profiles-daemon",
    ],
  },

  "group/gcontrol": {
    "orientation": "horizontal",
    "drawer": {
      "click-to-reveal": true,
      "transition-left-to-right": false,
      "children-class": "drawer",
    },
    "modules": [
      "custom/control",
      "idle_inhibitor",
      "custom/darkmode",
      "network",
      "bluetooth",
      "custom/socks",
      "wireplumber",
    ],
  },

  "group/gurgent": {
    "orientation": "horizontal",
    "modules": [
      "custom/spacer",
      "systemd-failed-units",
      "custom/voxtype",
      "privacy",
      "custom/notification",
      "battery",
    ],
  },

  //Modules configuration
  "include": ["~/.config/waybar/modules.jsonc"],
}
