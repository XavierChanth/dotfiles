{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|Multiedit",
        "hooks": [
          {
          "type": "command",
          "command": "jj new"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "mcp__serena__list_dir",
      "mcp__serena__find_symbol",
      "mcp__serena__find_file",
      "mcp__serena__get_symbols_overview"
    ],
    "deny": [
      "Bash(curl:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)"
    ]
  },
  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0"
  }
}
