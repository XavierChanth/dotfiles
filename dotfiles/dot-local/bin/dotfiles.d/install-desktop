#!/bin/bash

command_exists() {
  command -v "$1" >/dev/null 2>&1
}

if command_exists brew; then
  echo "brew package manager found, installing packages for brew"

  # common apps
  brew install zen-browser google-chrome chromium
  brew install zoom discord spotify
  brew install betterdisplay cleanshot unnaturalscrollwheels the-unarchiver

  # qutebrowser and dependencies
  brew install mpv qutebrowser

  # desktop tools & ricing
  brew tap felixkratz/formulae
  brew install aerospace sketchybar
  brew install dmenu-mac bitwarden-cli oath-toolkit

  # terminal stuff
  brew install wezterm asciinema neovide
  brew install font-jetbrains-mono-nerd-font

  # aerc and dependencies
  if command_exists aerc; then
    brew reinstall aerc
  else
    brew install aerc --HEAD
  fi
  # aerc dependencies
  brew install abook pandoc msmtp isync notmuch
  # brew services start isync # we will let aerc manage syncing
fi

# install wezterm terminfo
tempfile="$(mktemp)"
if [ -n "$tempfile" ]; then
  curl -o "$tempfile" "https://raw.githubusercontent.com/wez/wezterm/master/termwiz/data/wezterm.terminfo"
  tic -x -o ~/.terminfo "$tempfile"
fi
[ -n "$tempfile" ] && rm "$tempfile"
