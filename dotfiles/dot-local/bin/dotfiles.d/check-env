#!/bin/zsh

echo "Verifying environment..."
source "$HOME/.zshrc"

command_exists() {
  command -v "$1" >/dev/null 2>&1
}

LIGHT=false
if [ "$1" = "--light" ]; then
  LIGHT=true
fi

check_commands=(
  # essentials
  git
  curl
  ps
  brew
  # brew stuff
  bash
  zsh
  git
  sudo
  base32   # coreutils
  parallel # moreutils
  wget
  openssl
  tmux
  nvim
  rg # ripgrep
  fzf
  fd
  lazygit
  delta # git-delta
  bat
  stow
  go # golang
  # non-brew stuff
  spaceship
  lazygit
)

extra_commands=(
  uv
  python3 # python
  cmake
  cargo # rust
  node
  dotnet # dotnet-sdk
  gh
  jq
  yazi
  tokei
  quarto
  ffmpegthumbnailer
  unar
  pdfinfo # poppler
  # non-brew stuff
  dart
  flutter
  yazi
  # gh dash has special check
  csharp-ls
)

missing=""
for cmd in ${check_commands[@]}; do
  if ! command_exists "$cmd"; then
    missing="$missing $cmd "
  fi
done

if ! $LIGHT; then
  for cmd in ${extra_commands[@]}; do
    if ! command_exists "$cmd"; then
      missing="$missing $cmd "
    fi
  done
  if ! gh extension list | grep -q 'gh-dash' 2>/dev/null; then
    missing="$missing gh-dash"
  fi
fi

if [ -n "$missing" ]; then
  echo "Missing the following commands:"
  echo "$missing" | xargs -I% echo %
fi

echo "Done checking environment"
if [ -z "$missing" ]; then
  exit 0
else
  exit 1
fi
