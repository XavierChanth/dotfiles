#!/usr/bin/env bash

command_exists() {
  command -v "$1" >/dev/null 2>&1
}

if ! command_exists stow; then
  echo "stow not found, install gnu stow before continuing..."
  exit 2
fi

stow -d "$DOTFILES" -t "$HOME" --dotfiles dotfiles "$@"

function _stow() {
  dest="$1"
  name="$2"
  if [ $# -lt 2 ]; then return; fi
  mkdir -p "$dest"
  stow -d "$DOTFILES/dotfiles/dot-config" -t "$dest" "$name"
}

# MacOS
if [ "$(uname)" = 'Darwin' ]; then
  _stow "$HOME/Library/Application Support/Code/User" "vscode"
  _stow "$HOME/Library/Application Support/VSCodium/User" "vscode"
  _stow "$HOME/Library/Application Support/presenterm" "presenterm"
  _stow "$HOME/Library/Preferences/clangd" "clangd"
  sudo cp "$DOTFILES/dotfiles/dot-config/kanata/local.kanata.plist" /Library/LaunchDaemons/
  sudo launchctl unload /Library/LaunchDaemons/local.kanata.plist 2>/dev/null
  sudo launchctl load /Library/LaunchDaemons/local.kanata.plist
fi
unset _stow
