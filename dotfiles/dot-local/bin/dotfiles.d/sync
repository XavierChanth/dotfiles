#!/bin/bash

command_exists() {
  command -v "$1" >/dev/null 2>&1
}

if ! command_exists stow; then
  echo "stow not found, install gnu stow before continuing..."
  exit 2
fi

stow -d "$DOTFILES" -t "$HOME" --dotfiles dotfiles "$@"

# Like why, nobody cares about macos' stupid library dir, just support XDG base dirs
if [ $(uname) = 'Darwin' ]; then
  stow -d "$DOTFILES/dotfiles/dot-config" -t "$HOME/Library/Application Support/Code/User" "vscode"
  stow -d "$DOTFILES/dotfiles/dot-config" -t "$HOME/Library/Application Support/VSCodium/User" "vscode"
  mkdir -p "$HOME/Library/Preferences/clangd"
  stow -d "$DOTFILES/dotfiles/dot-config" -t "$HOME/Library/Preferences/clangd" "clangd"
fi
