#!/usr/bin/env bash

no_sudo=false
while [ $# -gt 0 ]; do
  case "$1" in
  --no-sudo)
    no_sudo=true
    shift
    ;;
  esac
done

if [ $UID -ne 0 ]; then
  echo Running root operations...
  exec sudo DOTFILES="$DOTFILES" "$0" "$@"
else
  $no_sudo && exit 0
  set -eux
  # operations as root
  systemctl daemon-reload
  systemd_start() {
    systemctl enable "$1"
    systemctl start "$1"
  }
  stow -d "$DOTFILES" -t "/" --dotfiles linux
  systemd_start "kanata.service"
  exit 0
fi

# operations as user
systemctl --user daemon-reload
systemd_start_user() {
  systemctl --user enable "$1"
  systemctl --user start "$1"
}

loginctl enable-linger
systemd_start_user "tmux-server.service"
