#!/usr/bin/env bash
set -eux

if [ $UID -ne 0 ]; then
  echo Running this as root...

  exec sudo DOTFILES="$DOTFILES" "$0" "$@"
fi

backup_dir="$DOTFILES/etc-backups/$(date -u +%s)"
mkdir -p "$backup_dir"
cat /etc/pf.conf >"$backup_dir/pc.conf"
rm /etc/pf.conf

pfctl -d || true
ln -s "$DOTFILES/etc/pf.conf" /etc/pf.conf
pfctl -e -f /etc/pf.conf
