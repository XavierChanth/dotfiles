#!/usr/bin/env bash
script_dir="$(dirname -- "$(readlink -f -- "$0")")"

install_desktop=false
while [ $# -gt 0 ]; do
  case "$1" in
  --desktop)
    install_desktop=true
    shift
    ;;
  *)
    echo "Unknown option: $1"
    exit 1
    ;;
  esac
done

# brew && fedora 41
PACKAGES=$(
  cat <<EOF
zsh
zsh-syntax-highlighting
bash
coreutils
moreutils
openssl
wget
tmux
neovim
ripgrep
fzf
git
git-delta
bat
stow
golang
rust
uv
python
gcc
cmake
ninja
zig
rust-analyzer
node
gh
jq
tokei
ffmpegthumbnailer
unar
poppler
just
EOF
)

export DOTFILES="$HOME/.dotfiles"

if [ -f /bin/zsh ] && [ "$SHELL" != "/bin/zsh" ]; then
  chsh -s /bin/zsh
fi

# Make files and directories used but not "owned" by dotfiles
zsh_state_dir="$HOME/.local/state/zsh"
mkdir -p "$zsh_state_dir/history/"
mkdir -p "$HOME/src"
mkdir -p "$HOME/.ssh/config.d" # ssh profiles that I don't want tracked in git go here
mkdir -p "$HOME/dev/local"
mkdir -p "$HOME/.local/bin"
mkdir -p "$HOME/.local/dev"
mkdir -p "$HOME/.local/state/colorscheme"
mkdir -p "$HOME/.cargo/bin"
mkdir -p "$HOME/.config"

touch "$HOME/.zshenv"
touch "$zsh_state_dir/main_history"
touch "$zsh_state_dir/tmux_history_cache"

# Prevent stow from adopting certain folders, and instead only link the files
touch "$HOME/.ssh/.stowkeep"
touch "$HOME/.local/.stowkeep"
touch "$HOME/.local/bin/.stowkeep"
touch "$HOME/.local/dev/.stowkeep"
touch "$HOME/.config/.stowkeep"

command_exists() {
  command -v "$1" >/dev/null 2>&1
}

# ensure git is installed
if ! command_exists git; then
  echo "git not found, install git before continuing..."
  exit 1
fi

platform=""

case "$(uname)" in
Darwin)
  $script_dir/configure-macos
  brew_path=/opt/homebrew/bin/brew
  platform="macos"
  ;;
Linux)
  brew_path=""
  platform="$(source /etc/os-release && echo $ID)"
  case $platform in
  ubuntu | fedora | arch) ;;
  *)
    echo "Distro not supported"
    exit 1
    ;;
  esac
  ;;
esac

# install brew
if [ -f "$brew_path" ]; then
  eval "$($brew_path shellenv)"
elif [ -n "$brew_path" ]; then
  echo "brew not found, installing it for you..."
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
else
  echo "not installing brew - unsupported"
fi

(curl --proto '=https' --tlsv1.2 -fsSL https://raw.githubusercontent.com/cargo-bins/cargo-binstall/main/install-from-binstall-release.sh | bash) 2>/dev/null

source "$script_dir/packages/$platform"
case "$platform" in
macos)
  brew analytics off
  brew install $PACAKGES
  if $install_desktop; then
    brew tap $DESKTOP_TAPS
    brew install $DESKTOP_PACKAGES
  fi
  ;;
ubuntu)
  sudo -v
  sudo apt-get install -y $PACKAGES
  ;;
fedora)
  sudo -v
  sudo dnf install -y $PACKAGES

  cargo binstall --disable-telemetry -y \
    --strategies crate-meta-data,quick-install,compile \
    $CARGO_PACKAGES
  ;;
arch)
  sudo -v
  sudo pacman -S --needed git base-devel

  # setup yay for access to aur
  (
    mkdir ~/.local/dev
    git clone https://aur.archlinux.org/yay.git ~/.local/dev/yay
    cd ~/.local/dev/yay || exit 1
    makepkg -si
  )

  yay -S $PACKAGES

  if $install_desktop; then
    yay -S $DESKTOP_PACKAGES
  fi
  ;;

esac

# install spaceship
git clone --depth=1 https://github.com/spaceship-prompt/spaceship-prompt.git "$HOME/.config/spaceship-prompt" 2>/dev/null ||
  git -C "$HOME/.config/spaceship-prompt" pull

# sync dotfiles
"$script_dir"/sync || exit $?

if command_exists go; then
  go install github.com/jesseduffield/lazygit@latest
fi

# Install flutter
export FLUTTER_ROOT="$HOME/.local/dev/flutter"
git clone https://github.com/flutter/flutter.git "$FLUTTER_ROOT" 2>/dev/null
"$HOME"/.local/dev/flutter/bin/flutter --disable-analytics
"$HOME"/.local/dev/flutter/bin/flutter channel stable

# csharp-ls
if command_exists dotnet; then
  dotnet tool install --global csharp-ls
fi

# install venv for nvim
if ! [ -d "$DOTFILES/.venv" ]; then
  (
    cd "$DOTFILES" || return 1
    uv venv
    source "$DOTFILES/.venv/bin/activate"
    uv pip install pynvim jupyter_client cairosvg plotly kaleido pnglatex pyperclip jupytext
  )
fi

# sync nvim
$script_dir/../color.d/apply-color tokyonight-storm
nvim --headless "+Lazy! sync" +qa
# Install python provider for nvim

# Do a healthcheck to ensure that everything I want is installed

"$script_dir"/check-env
exit $?
