#!/usr/bin/env bash
script_dir="$(dirname -- "$(readlink -f -- "$0")")"

export DOTFILES="$HOME/.dotfiles"

LIGHT=false
if [ "$1" = "--light" ]; then
  LIGHT=true
fi

if [ -f /bin/zsh ] && [ "$SHELL" != "/bin/zsh" ]; then
  chsh -s /bin/zsh
fi

# Make files and directories used but not "owned" by dotfiles
zsh_state_dir="$HOME/.local/state/zsh"
mkdir -p "$zsh_state_dir/history/"
mkdir -p "$HOME/src"
mkdir -p "$HOME/.ssh/config.d" # ssh profiles that I don't want tracked in git go here
mkdir -p "$HOME/dev/local"
mkdir -p "$HOME/.local/bin"
mkdir -p "$HOME/.config"

touch "$HOME/.zshenv"
touch "$zsh_state_dir/main_history"
touch "$zsh_state_dir/tmux_history_cache"

# Prevent stow from adopting certain folders, and instead only link the files
touch "$HOME/.ssh/.stowkeep"
touch "$HOME/.local/.stowkeep"
touch "$HOME/.local/bin/.stowkeep"
touch "$HOME/.local/dev/.stowkeep"
touch "$HOME/.config/.stowkeep"

command_exists() {
  command -v "$1" >/dev/null 2>&1
}

# ensure git is installed
if ! command_exists git; then
  echo "git not found, install git before continuing..."
  exit 1
fi

case "$(uname)" in
Darwin)
  $script_dir/configure-macos
  brew_path=/opt/homebrew/bin/brew
  ;;
Linux)
  brew_path=/home/linuxbrew/.linuxbrew/bin/brew
  ;;
esac

# install brew
if [ -f "$brew_path" ]; then
  eval "$($brew_path shellenv)"
else
  echo "brew not found, installing it for you..."
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi

if [ "$(uname)" = 'Darwin' ]; then
  brew install orbstack
fi

brew install $(
  cat <<EOF
zsh
zsh-syntax-highlighting
bash
coreutils
moreutils
openssl
wget
tmux
neovim
ripgrep
fzf
fd
git
jj
git-delta
bat
stow
golang
EOF
)

if ! $LIGHT; then
  brew install $(
    cat <<EOF
uv
python
gcc
cmake
ninja
zig
rust
rust-analyzer
node
gh
jq
yazi
tokei
ffmpegthumbnailer
unar
poppler
imagemagick
hwatch
just
EOF
  )

  case "$(uname)" in
  Darwin)
    brew install $(
      cat <<EOF
dotnet-sdk
quarto
EOF
    )
    ;;
  Linux)
    brew install $(
      cat <<EOF
dotnet
EOF
    )
    ;;
  esac
fi

# install spaceship
git clone --depth=1 https://github.com/spaceship-prompt/spaceship-prompt.git "$HOME/.config/spaceship-prompt" 2>/dev/null ||
  git -C "$HOME/.config/spaceship-prompt" pull

# sync dotfiles
$script_dir/sync || exit $?

if ! $LIGHT; then
  if command_exists go; then
    go install github.com/jesseduffield/lazygit@latest
  fi

  # Install flutter
  export FLUTTER_ROOT="$HOME/.local/dev/flutter"
  git clone https://github.com/flutter/flutter.git "$FLUTTER_ROOT" 2>/dev/null
  "$HOME"/.local/dev/flutter/bin/flutter --disable-analytics
  "$HOME"/.local/dev/flutter/bin/flutter channel stable

  # csharp-ls
  if command_exists dotnet; then
    dotnet tool install --global csharp-ls
  fi

  # install venv for nvim
  if ! [ -d "$DOTFILES/.venv" ]; then
    (
      cd "$DOTFILES" || return 1
      uv venv
      source "$DOTFILES/.venv/bin/activate"
      uv pip install pynvim jupyter_client cairosvg plotly kaleido pnglatex pyperclip jupytext
    )
  fi

  # sync nvim
  nvim --headless "+Lazy! sync" +qa
# Install python provider for nvim
fi

# Do a healthcheck to ensure that everything I want is installed

if ! $LIGHT; then
  "$script_dir"/check-env
else
  "$script_dir"/check-env --light
fi
exit $?
