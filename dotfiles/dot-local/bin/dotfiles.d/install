#!/usr/bin/env bash
script_dir="$(dirname -- "$(readlink -f -- "$0")")"

install_desktop=false
while [ $# -gt 0 ]; do
  case "$1" in
  --desktop)
    install_desktop=true
    echo "Installing desktop packages"
    shift
    ;;
  *)
    echo "Unknown option: $1"
    exit 1
    ;;
  esac
done

export DOTFILES="$HOME/.dotfiles"
packages_dir="$DOTFILES/packages"

if [ -f /bin/zsh ] && [ "$SHELL" != "/bin/zsh" ]; then
  chsh -s /bin/zsh
fi

# Make files and directories used but not "owned" by dotfiles
zsh_state_dir="$HOME/.local/state/zsh"
mkdir -p "$zsh_state_dir/history/"
mkdir -p "$HOME/src"
mkdir -p "$HOME/.ssh/config.d" # ssh profiles that I don't want tracked in git go here
mkdir -p "$HOME/.ssh/control"
mkdir -p "$HOME/.local/bin"
mkdir -p "$HOME/.local/dev"
mkdir -p "$HOME/.local/state/colorscheme"
mkdir -p "$HOME/.cargo/bin"
mkdir -p "$HOME/.config"
mkdir -p "$HOME/Documents" "$HOME/Downloads" "$HOME/Recordings" "$HOME/Screenshots"

touch "$HOME/.zshenv"
touch "$zsh_state_dir/main_history"
touch "$zsh_state_dir/tmux_history_cache"

# Prevent stow from adopting certain folders, and instead only link the files
touch "$HOME/.ssh/.stowkeep"
touch "$HOME/.local/.stowkeep"
touch "$HOME/.local/bin/.stowkeep"
touch "$HOME/.local/dev/.stowkeep"
touch "$HOME/.config/.stowkeep"

command_exists() {
  command -v "$1" >/dev/null 2>&1
}

nix_cmd() {
  NIXPKGS_ALLOW_UNFREE=1 NIX_CONFIG="experimental-features = nix-command flakes" nix "$@"
}

install_nix_flake_attr() {
  local attr="$1"
  local name="$2"
  local ref="$packages_dir#$attr"

  echo "Installing $name package group from $ref"
  nix_cmd profile install --accept-flake-config "$ref"
}

install_nix() {
  if command_exists nix; then
    return 0
  fi

  echo "nix not found, installing it for you..."

  if curl --proto '=https' --tlsv1.2 -fsSL https://install.determinate.systems/nix | sh -s -- install --no-confirm; then
    :
  else
    echo "Determinate installer failed; falling back to official Nix installer"
    sh <(curl -L https://nixos.org/nix/install) --daemon
  fi

  if [ -f /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh ]; then
    # shellcheck disable=SC1091
    source /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh
  elif [ -f "$HOME/.nix-profile/etc/profile.d/nix.sh" ]; then
    # shellcheck disable=SC1090
    source "$HOME/.nix-profile/etc/profile.d/nix.sh"
  fi

  if ! command_exists nix; then
    echo "nix installation completed, but nix is not available in the current shell"
    echo "Open a new shell and re-run this installer"
    exit 1
  fi
}

# ensure git is installed
if ! command_exists git; then
  echo "git not found, install git before continuing..."
  exit 1
fi

platform=""
platform_dir=""

case "$(uname)" in
Darwin)
  platform="macos"
  platform_dir="Darwin"
  ;;
Linux)
  platform="linux"
  platform_dir="Linux"
  ;;
*)
  echo "Platform not supported"
  exit 1
  ;;
esac

if [ -x "$script_dir/$platform_dir/configure-defaults" ]; then
  "$script_dir/$platform_dir/configure-defaults"
fi

install_nix

if [ ! -f "$packages_dir/flake.nix" ]; then
  echo "Missing flake at $packages_dir/flake.nix"
  exit 1
fi

install_nix_flake_attr "common" "common"
install_nix_flake_attr "$platform" "$platform"

if $install_desktop; then
  install_nix_flake_attr "desktopCommon" "desktop common"
  case "$platform" in
  macos)
    install_nix_flake_attr "desktopMacos" "desktop $platform"
    ;;
  linux)
    install_nix_flake_attr "desktopLinux" "desktop $platform"
    ;;
  esac
fi

# install spaceship
git clone --depth=1 https://github.com/spaceship-prompt/spaceship-prompt.git "$HOME/.config/spaceship-prompt" 2>/dev/null ||
  git -C "$HOME/.config/spaceship-prompt" pull

# sync dotfiles
"$script_dir"/sync || exit $?

if command_exists go; then
  go install github.com/jesseduffield/lazygit@latest
fi

# Install flutter
export FLUTTER_ROOT="$HOME/.local/dev/flutter"
git clone https://github.com/flutter/flutter.git "$FLUTTER_ROOT" 2>/dev/null
"$HOME"/.local/dev/flutter/bin/flutter --disable-analytics
"$HOME"/.local/dev/flutter/bin/flutter channel stable

# csharp-ls
if command_exists dotnet; then
  dotnet tool install --global csharp-ls
fi

# ruby-lsp
if command_exists gem; then
  gem install ruby-lsp rubocop
fi

# Apply my colorscheme
"$script_dir"/../color.d/apply-color tokyonight-storm

# sync nvim
if command_exists bob; then
  bob use nightly
fi
if command_exists nvim; then
  nvim --headless +PackInstall +qa # vim pack with my user command
fi

# Do a healthcheck to ensure that everything I want is installed
"$script_dir"/check-env
exit $?
