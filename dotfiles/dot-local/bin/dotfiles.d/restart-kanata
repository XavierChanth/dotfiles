#!/usr/bin/env bash

install_launchd_daemon() {
  dir=$1
  file=$2
  sudo cp "$dir/$file" "/Library/LaunchDaemons/"
  sudo launchctl unload "/Library/LaunchDaemons/$file" 2>/dev/null
  sudo launchctl load "/Library/LaunchDaemons/$file"
}

if [ "$(uname)" = 'Darwin' ]; then
  # install_launchd_daemon "$DOTFILES/dotfiles/dot-config/kanata" "local.karabiner.plist"
  install_launchd_daemon "$DOTFILES/dotfiles/dot-config/kanata" "local.karabiner-daemon.plist"
  install_launchd_daemon "$DOTFILES/dotfiles/dot-config/kanata" "local.karabiner-manager.plist"
  install_launchd_daemon "$DOTFILES/dotfiles/dot-config/kanata" "local.kanata.plist"
fi
