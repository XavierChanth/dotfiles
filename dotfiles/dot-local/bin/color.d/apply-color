#!/bin/bash

theme=$1
colorscheme_dir="$HOME/.local/state/colorscheme"

echo "return '$theme'" >$colorscheme_dir/colorscheme.lua
echo "$theme" >$colorscheme_dir/colorscheme
case "$theme" in
tokyonight-moon)
  ghostty_theme="tokyonight_moon"
  ;;
tokyonight-night)
  ghostty_theme="tokyonight_night"
  ;;
*)
  ghostty_theme="$theme"
  ;;
esac
echo "theme=$ghostty_theme" >$HOME/.config/ghostty/colorscheme
