#!/usr/bin/env bash

script_dir="$(dirname -- "$(readlink -f -- "$0")")"
source "$script_dir/include.d/tmux_session.sh"

selected=$(
  (
    # tested find against fd, for a small set of directories like this find is slightly faster
    # now, if you were recursively searching all files, fd wins by a mile
    find "$HOME/src" -mindepth 1 -maxdepth 1 -type d
    # fd . "$HOME/src" "$HOME/dev" --min-depth 1 -d 1 -t dir
  ) |
    fzf --scheme=path --tiebreak=end,index --header "Create in?"
)

printf "Project name: "
read name

if [ -d "$selected/$name" ] && [ -n "$name" ]; then
  echo "Project already exists, opening existing"
  sleep 1
else
  mkdir -p "$selected/$name"
fi

add_session "$selected/$name"
