#!/usr/bin/env bash

root="$(git rev-parse --show-toplevel)"

name="opencode-"

existing="$(tmux lsw -F "#{window_id}" -f "#{==:#W,$name}")"

if [ -n "$existing" ]; then
  tmux select-window -t "$existing"
  exit 0
fi

tmux neww -c "$root" "opencode"
tmux rename-window $name
jj_pos="$(tmux lsw -F "#I" -f "#{==:#W,jj-}")"
# move the window to after jj-term if open, otherwise move it to 2
if [ -n "$jj_pos" ]; then
  pos=$((jj_pos + 1))
  tmux movew -b -t ":$pos"
  tmux selectw -t ":$pos"
else
  tmux movew -b -t :2
  tmux selectw -t :2
fi
