#!/usr/bin/env bash

colorscheme_dir="$HOME/.local/state/colorscheme/"
script_dir="$(dirname -- "$(readlink -f -- "$0")")"

[ -d "$colorscheme_dir" ] || mkdir -p $colorscheme_dir

color="$1"

theme=$($script_dir/list-colors | fzf -d "\n")

if [ -n "$theme" ]; then
  echo "return '$theme'" >$colorscheme_dir/colorscheme.lua
  echo "$theme" >$colorscheme_dir/colorscheme
  sketchybar --reload
  tmux source ~/.config/tmux/tmux.conf
fi
