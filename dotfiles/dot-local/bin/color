#!/usr/bin/env bash

colorscheme_dir="$HOME/.local/state/colorscheme/"
script_dir="$(dirname -- "$(readlink -f -- "$0")")"

[ -d "$colorscheme_dir" ] || mkdir -p $colorscheme_dir

color="$1"

theme=$($script_dir/list-colors | fzf -d "\n")

if [ -n "$theme" ]; then
  $script_dir/color.d/apply-color $theme
  # ghostty +reload_config # not supported yet
  sketchybar --reload
  tmux source ~/.config/tmux/tmux.conf
fi
