#!/usr/bin/env bash

colorscheme_dir="$HOME/.local/state/colorscheme/"
script_dir="$(dirname -- "$(readlink -f -- "$0")")"

[ -d "$colorscheme_dir" ] || mkdir -p $colorscheme_dir

color="$1"

theme=$($script_dir/list-colors | fzf -d "\n")

if [ -n "$theme" ]; then
  $script_dir/color.d/apply-color $theme
  if command -v sketchybar >/dev/null 2>&1; then
    sketchybar --reload
  fi
  tmux source ~/.config/tmux/tmux.conf

  # reload the current ghostty window
  if command -v osascript >/dev/null 2>&1; then
    osascript -e '
    tell application "Ghostty"
      activate
    end tell
    tell application "System Events"
      tell process "Ghostty"
        click menu item "Reload Configuration" of menu "Ghostty" of menu bar 1
      end tell
    end tell
  ' >/dev/null
  fi
fi
