#!/bin/bash

script_dir="$(dirname -- "$(readlink -f -- "$0")")"
source "$script_dir/include.d/tmux_session.sh"

includes=$(cat "$HOME/.ssh/config" | rg 'Include ' | cut -d ' ' -f2 | sed -e "s|^|$HOME/.ssh/|")
files=$(echo $includes) # expands globs
hosts=$(sed -e 's/ /\n/g' <<<$files | xargs -I % /bin/sh -c 'cat "%" | grep "Host " | grep -v "Host \*" | cut -d " " -f2')

selected=$(
  sed -e 's/ /\n/g' <<<$hosts | fzf -d=' ' --scheme=path --tiebreak=end,index --header "Open tmux session"
)

[ -z $selected ] && return

name="ssh-$selected"
# add sshnp to path so it works in ProxyCommands
command="PATH='$PATH:$HOME/.local/bin'; ssh $selected"

add_session "$selected" "$name" "$command"
