{
  "$schema": "https://opencode.ai/config.json",
  // Basic Customization
  "theme": "tokyonight",
  "keybinds": {
    "model_cycle_favorite": "ctrl+n",
    "messages_half_page_up": "ctrl+u",
    "messages_half_page_down": "ctrl+d",
    "editor_open": "ctrl+e",
  },
  "autoupdate": true,

  // Permissions
  "permission": {
    "bash": {
      "rm *": "ask",
    },
  },
  "share": "disabled", // code is sensitive, there should be no room for mistakes

  // Agentic
  "compaction": { "auto": true, "prune": true },
  "default_agent": "build",
  "agent": {},

  // Models
  "model": "openai/gpt-5.3-codex",
  "small_model": "opencode/gpt-5-nano",

  "provider": {
    "openai": { "whitelist": ["gpt-5.3-codex", "gpt-5.2-codex", "gpt-5.2"] },
    "cloudflare-ai-gateway": {
      "whitelist": [
        "anthropic/claude-opus-4-6",
        "anthropic/claude-opus-4-5",
        "anthropic/claude-sonnet-4-5",
        "anthropic/claude-haiku-4-5",
      ],
    },
    "cloudflare-workers-ai": { "whitelist": [] },
    "zai-coding-plan": {
      "whitelist": ["glm-4.7", "glm-4.7-flash"],
      // "options": {
      //   "baseURL": "https://gateway.ai.cloudflare.com/v1/{env:CLOUDFLARE_ACCOUNT_ID}/{env:CLOUDFLARE_GATEWAY_ID}/custom-zai/v4",
      //   "headers": { "cf-aig-authorization": "Bearer {env:CF_AIG_TOKEN}" },
      // },
    },
    "opencode": {
      "whitelist": [
        "gpt-5-nano", // small model
        "claude-opus-4-6",
        "claude-opus-4-5",
        "claude-sonnet-4-5",
        "claude-haiku-4-5",
        "gemini-3-pro",
        "gemini-3-flash",
        "minimax-m2.1",
        "qwen3-coder",
        "kimi-k2.5",
      ],
      // "npm": "@ai-sdk/openai-compatible",
      // "options": {
      //   "baseURL": "https://gateway.ai.cloudflare.com/v1/{env:CLOUDFLARE_ACCOUNT_ID}/{env:CLOUDFLARE_GATEWAY_ID}/custom-zen",
      //   "headers": { "cf-aig-authorization": "Bearer {env:CF_AIG_TOKEN}" },
      // },
    },
  },

  // Tools
  "skills": {
    "paths": ["~/.config/agents/skills/"],
  },
  "command": {},
  "lsp": {},
  "mcp": {},
  "plugin": [],
  "tools": {},
}
