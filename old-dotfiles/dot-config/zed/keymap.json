// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    // Global Navigation Binds
    "bindings": {
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-w": "pane::CloseActiveItem",
      "ctrl--": "workspace::ToggleBottomDock"
    }
  },
  {
    // Normal & Visual Mode
    "context": "VimControl && !menu",
    "bindings": {
      "cmd-j": ["workspace::SendKeystrokes", "5 j"],
      "cmd-k": ["workspace::SendKeystrokes", "5 k"],
      "space c a": "editor::ToggleCodeActions",
      "space a": "editor::ToggleCodeActions",
    }
  },
  {
    // Navigation: Normal Mode & blank screens
    "context": "vim_mode == normal && !menu || EmptyPane || SharedScreen",
    "bindings": {
      "space space": "file_finder::Toggle",
      "space j": "tab_switcher::Toggle",
      "space e": "workspace::ToggleLeftDock",
      "space b r": "workspace::ReloadActiveItem",
      "space \\": "pane::SplitRight",
      "space -": "pane::SplitDown",
      "space s g": "workspace::NewSearch",
      "space s s": "outline::Toggle",
      "space s S": "project_symbols::Toggle",
      "space x x": "diagnostics::Deploy",
      "space q q": "zed::Quit"
    }
  },
  {
    // Normal mode in buffer
    "context": "vim_mode == normal && !VimWaiting && !menu",
    "bindings": {
      "space c r": "editor::Rename",
      "space g b": "editor::ToggleGitBlameInline",
      "g d": "editor::GoToDefinition",
      "g D": "editor::GoToDeclaration",
      "g I": "editor::GoToImplementation",
      "g y": "editor::GoToTypeDefinition",
      "g r": "editor::FindAllReferences",
      // "] d": "editor::GoToDiagnostic",
      // "[ d": "editor::GoToPreviousDiagnostic"
    }
  },
  {
    // Visual mode in buffer
    "context": "vim_mode == visual && !menu",
    "bindings": {
      "<": ["workspace::SendKeystrokes", "g < g v"],
      ">": ["workspace::SendKeystrokes", "g > g v"],
      "g <": "vim::Outdent",
      "g >": "vim::Indent"
    }
  },
  {
    // Insert mode in buffer
    "context": "vim_mode == insert && !menu",
    "bindings": {
      "ctrl-n": "editor::ShowCompletions",
      "ctrl-p": "editor::ShowCompletions"
    }
  },
  {
    // cmp triggered
    "context": "vim_mode == insert && menu",
    "bindings": {
      "tab": null,
      "shift-tab": null
    }
  },
  {
    // Pick buffers
    "context": "TabSwitcher",
    "bindings": {
      "j": "menu::SelectNext",
      "k": "menu::SelectPrevious",
      "ctrl-d": "tab_switcher::CloseSelectedItem"
    }
  },
  {
    // Project panel toggle
    "context": "Dock && !Terminal",
    "bindings": {
      "space e": "workspace::ToggleLeftDock"
    }
  },
  {
    // Project panel maps
    "context": "ProjectPanel",
    "bindings": {
      "enter": ["workspace::SendKeystrokes", "shift enter space e"],
      "shift enter": "project_panel::Open",
      "o": "project_panel::NewFile",
      "d": "project_panel::Delete",
      "y": "project_panel::Copy",
      "x": "project_panel::Cut",
      "p": "project_panel::Paste",
      "r": "project_panel::Rename"
    }
  },
]
