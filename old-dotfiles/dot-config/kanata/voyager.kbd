(defcfg
  process-unmapped-keys no
  macos-dev-names-include ("Voyager")
  linux-dev-names-include ("Voyager")
)

(defsrc
  grv  1 2 3 4 5 6 7 8 9 0 -
  tab  q w e r t y u i o p \
  esc  a s d f g h j k l ; '
  lsft z x c v b n m , . / =

  lctl lalt lmet rmet ralt rsft rctl
  spc bscp ret
)

(deflayer base
  _ _ _ _ _ _ _ _ _ _ _ _
  _ _ _ _ _ _ _ _ _ _ _ _
  _ _ _ _ _ _ _ _ _ _ _ _
  _ _ _ _ _ _ _ _ _ _ _ _
  _ _ _ _ _ _ _
  _ _ _
)

