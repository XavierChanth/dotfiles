#!/usr/bin/env bash

# Agent spawner, aka "token burner mk.7"

set -euo pipefail

usage() {
  cat <<'EOF'
Usage: agent-spawner [options]

Spawn multiple coding agents in parallel (one tmux window + jj workspace per row).

Options:
  -f, --matrix <file>          Matrix file (required)
  -p, --prompt <file>          Prompt file (default: repo root PROMPT.md or prompt.md)
  -w, --workspace-root <dir>   Workspace root under repo (default: .work/agent-spawner)
      --prefix <name>          Tmux window name prefix (default: empty)
      --restart                Restart existing matching windows
      --dry-run                Print actions without creating windows/workspaces
  -h, --help                   Show this help

Matrix format (Markdown fenced tsv block; spaces or tabs between columns):

```tsv
harness model thinking
codex gpt-5.3-codex medium
opencode openai/gpt-5.3-codex high
claude claude-opus-4-6 10000
```

"thinking" maps to:
- thinking level in codex
- variant in opencode
- CLAUDE_CODE_EFFORT_LEVEL in claude
EOF
}

die() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

usage_error() {
  printf 'error: %s\n\n' "$*" >&2
  usage >&2
  exit 2
}

trim() {
  local s="$1"
  s="${s#"${s%%[![:space:]]*}"}"
  s="${s%"${s##*[![:space:]]}"}"
  printf '%s' "$s"
}

slugify() {
  local input="$1"
  local slug
  slug="$(printf '%s' "${input,,}" | tr -cs 'a-z0-9' '-' | sed -E 's/^-+//; s/-+$//; s/-+/-/g')"
  if [ -z "$slug" ]; then
    slug="agent"
  fi
  printf '%s' "${slug:0:42}"
}

jj_workspace_add_with_retry() {
  local repo_root="$1"
  local workspace_path="$2"
  local attempt

  for attempt in 1 2 3 4 5; do
    if (
      cd "$repo_root"
      jj workspace add "$workspace_path"
    ); then
      return 0
    fi
    sleep 0.2
  done

  return 1
}

extract_tsv_block() {
  local file="$1"
  awk '
    BEGIN { in_block = 0 }
    /^```[[:space:]]*tsv[[:space:]]*$/ { in_block = 1; next }
    in_block && /^```[[:space:]]*$/ { in_block = 0; exit }
    in_block { print }
  ' "$file"
}

window_id_by_name() {
  local name="$1"
  tmux list-windows -F '#{window_id}\t#{window_name}' | awk -F '\t' -v name="$name" '$2 == name { print $1; exit }'
}

build_agent_command() {
  local harness="$1"
  local model="$2"
  local thinking="$3"
  local workspace="$4"
  local prompt_file="$5"
  local model_display="${model##*/}"

  case "$harness" in
    codex)
      printf 'codex -C %q -m %q -c %q "$(cat %q)"' \
        "$workspace" "$model" "model_reasoning_effort=\"$thinking\"" "$prompt_file"
      ;;
    opencode)
      printf 'opencode run -m %q --variant %q --agent build --title %q "$(cat %q)"' \
        "$model" "$thinking" "$model_display [$thinking]" "$prompt_file"
      ;;
    claude)
      printf 'CLAUDE_CODE_EFFORT_LEVEL=%q claude --model %q --agent build "$(cat %q)"' \
        "$thinking" "$model" "$prompt_file"
      ;;
    *)
      return 1
      ;;
  esac
}

matrix_file=""
matrix_provided=false
prompt_file=""
workspace_root=".work/agent-spawner"
prefix=""
restart=false
dry_run=false

while [ "$#" -gt 0 ]; do
  case "$1" in
    -f|--matrix)
      [ "$#" -ge 2 ] || usage_error "missing value for $1"
      matrix_file="$2"
      matrix_provided=true
      shift 2
      ;;
    -p|--prompt)
      [ "$#" -ge 2 ] || die "missing value for $1"
      prompt_file="$2"
      shift 2
      ;;
    -w|--workspace-root)
      [ "$#" -ge 2 ] || die "missing value for $1"
      workspace_root="$2"
      shift 2
      ;;
    --prefix)
      [ "$#" -ge 2 ] || die "missing value for $1"
      prefix="$2"
      shift 2
      ;;
    --restart)
      restart=true
      shift
      ;;
    --dry-run)
      dry_run=true
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      die "unknown argument: $1"
      ;;
  esac
done

[ "$matrix_provided" = true ] || usage_error "missing required option: -f|--matrix"

command -v jj >/dev/null 2>&1 || die "jj not found"
command -v tmux >/dev/null 2>&1 || die "tmux not found"

repo_root="$(jj root 2>/dev/null || true)"
[ -n "$repo_root" ] || die "not in a jj repository"

if [ "${matrix_file#/}" = "$matrix_file" ]; then
  matrix_file="$repo_root/$matrix_file"
fi
[ -f "$matrix_file" ] || die "matrix file not found: $matrix_file"

if [ -z "$prompt_file" ]; then
  if [ -f "$repo_root/PROMPT.md" ]; then
    prompt_file="$repo_root/PROMPT.md"
  elif [ -f "$repo_root/prompt.md" ]; then
    prompt_file="$repo_root/prompt.md"
  else
    die "missing prompt file at repo root (PROMPT.md or prompt.md)"
  fi
elif [ "${prompt_file#/}" = "$prompt_file" ]; then
  prompt_file="$repo_root/$prompt_file"
fi
[ -f "$prompt_file" ] || die "prompt file not found: $prompt_file"

if [ "${workspace_root#/}" = "$workspace_root" ]; then
  workspace_root="$repo_root/$workspace_root"
fi

mapfile -t matrix_lines < <(extract_tsv_block "$matrix_file")
[ "${#matrix_lines[@]}" -gt 0 ] || die "no tsv block found in matrix file"

declare -a harnesses=()
declare -a models=()
declare -a thinkings=()

header_seen=false
for raw_line in "${matrix_lines[@]}"; do
  line="${raw_line%$'\r'}"
  line="$(trim "$line")"
  [ -n "$line" ] || continue

  if [[ "$line" == \#* ]]; then
    stripped="$(trim "${line#\#}")"
    if [ "$header_seen" = false ] && [[ "${stripped,,}" =~ ^harness[[:space:]]+model[[:space:]]+thinking([[:space:]]|$) ]]; then
      header_seen=true
    fi
    continue
  fi

  if [ "$header_seen" = false ]; then
    if [[ "${line,,}" =~ ^harness[[:space:]]+model[[:space:]]+thinking([[:space:]]|$) ]]; then
      header_seen=true
      continue
    fi
    die "first non-comment row in matrix block must be header: harness model thinking"
  fi

  IFS=$' \t' read -r harness model thinking _ <<< "$line"
  harness="$(trim "$harness")"
  model="$(trim "$model")"
  thinking="$(trim "$thinking")"

  [ -n "$harness" ] || die "missing harness in row: $line"
  [ -n "$model" ] || die "missing model in row: $line"
  [ -n "$thinking" ] || die "missing thinking in row: $line"

  case "$harness" in
    codex|opencode|claude) ;;
    *) die "unsupported harness '$harness' (expected codex, opencode, or claude)" ;;
  esac

  harnesses+=("$harness")
  models+=("$model")
  thinkings+=("$thinking")
done

[ "${#harnesses[@]}" -gt 0 ] || die "no matrix rows found"

need_codex=false
need_opencode=false
need_claude=false
for harness in "${harnesses[@]}"; do
  [ "$harness" = "codex" ] && need_codex=true
  [ "$harness" = "opencode" ] && need_opencode=true
  [ "$harness" = "claude" ] && need_claude=true
done

[ "$need_codex" = false ] || command -v codex >/dev/null 2>&1 || die "codex not found"
[ "$need_opencode" = false ] || command -v opencode >/dev/null 2>&1 || die "opencode not found"
[ "$need_claude" = false ] || command -v claude >/dev/null 2>&1 || die "claude not found"

if ! tmux list-sessions >/dev/null 2>&1; then
  die "tmux server is not running"
fi

mkdir -p "$workspace_root"

last_window_target=""
printf 'Using repo: %s\n' "$repo_root"
printf 'Prompt file: %s\n' "$prompt_file"
printf 'Matrix file: %s\n' "$matrix_file"

declare -a pids=()
declare -a outputs=()
starting_window_id=""
if [ "$dry_run" = false ]; then
  starting_window_id="$(tmux display-message -p '#{window_id}' 2>/dev/null || true)"
fi

for i in "${!harnesses[@]}"; do
  harness="${harnesses[$i]}"
  model="${models[$i]}"
  thinking="${thinkings[$i]}"
  row_num="$((i + 1))"
  row_tag="$(printf '%03d' "$row_num")"

  slug_base="$(slugify "$harness-$model")"
  thinking_slug="$(slugify "$thinking")"
  slug="$row_tag-$slug_base-$thinking_slug"

  workspace_path="$workspace_root/$slug"
  if [ -n "$prefix" ]; then
    window_name="$prefix-$slug"
  else
    window_name="$slug"
  fi

  output_file="$(mktemp)"
  outputs+=("$output_file")

  (
    set -euo pipefail

    workspace_status="reused"
    if [ ! -d "$workspace_path" ]; then
      workspace_status="created"
      if [ "$dry_run" = false ]; then
        jj_workspace_add_with_retry "$repo_root" "$workspace_path"
      fi
    fi

    agent_cmd="$(build_agent_command "$harness" "$model" "$thinking" "$workspace_path" "$prompt_file")"
    if [ "$harness" = "opencode" ]; then
      wrapped_cmd="$agent_cmd; exec zsh -li"
      tmux_cmd="bash -lc $(printf '%q' "$wrapped_cmd")"
    else
      tmux_cmd="bash -lc $(printf '%q' "$agent_cmd")"
    fi

    window_status="created"
    if [ "$dry_run" = false ]; then
      existing_window_id="$(window_id_by_name "$window_name" || true)"
      if [ -n "$existing_window_id" ]; then
        window_status="reused"
        if [ "$restart" = true ]; then
          window_status="restarted"
          tmux respawn-window -k -t "$existing_window_id" -c "$workspace_path" "$tmux_cmd"
        fi
      else
        tmux new-window -d -n "$window_name" -c "$workspace_path" "$tmux_cmd"
      fi
    fi

    {
      printf '[%d] %s | model=%s | thinking=%s\n' "$row_num" "$harness" "$model" "$thinking"
      printf '    workspace: %s (%s)\n' "$workspace_path" "$workspace_status"
      printf '    window:    %s (%s)\n' "$window_name" "$window_status"
      if [ "$dry_run" = true ]; then
        printf '    command:   %s\n' "$agent_cmd"
      fi
    } >"$output_file"
  ) &

  pids+=("$!")
done

failures=0
for i in "${!pids[@]}"; do
  if ! wait "${pids[$i]}"; then
    failures=$((failures + 1))
  fi
done

for output_file in "${outputs[@]}"; do
  if [ -f "$output_file" ]; then
    while IFS= read -r line; do
      printf '%s\n' "$line"
    done <"$output_file"
    rm -f "$output_file"
  fi
done

if [ "$failures" -gt 0 ]; then
  die "$failures agent spawn job(s) failed"
fi

if [ "$dry_run" = false ] && [ -n "$starting_window_id" ]; then
  tmux select-window -t "$starting_window_id"
fi
