#!/usr/bin/env bash

script_dir="$(dirname -- "$(readlink -f -- "$0")")"
scripts_path="$script_dir/dotfiles.d"
scripts=$(ls -1 "$scripts_path")
uname=$(uname)
uname_scripts=$(ls -1 "$scripts_path/$uname")

usage() {
  echo "Usage:"
  echo "dotfiles <command>"
  echo
  echo "Available commands:"
  for file in $scripts; do
    if [ -d "$scripts_path/$file" ]; then
      continue
    fi
    echo $file
  done
  for file in $uname_scripts; do
    if [ -d "$scripts_path/$uname/$file" ]; then
      continue
    fi
    echo $(basename $file)
  done
}

main() {
  local command=$1
  shift 1

  if [ -z $command ]; then
    usage
    return 1
  fi

  local found=false
  for file in $scripts; do
    if [ "$command" = "$file" ]; then
      $scripts_path/$command $@
      found=true
    fi
  done

  if [ -d $scripts_path/$uname ]; then
    for file in $uname_scripts; do
      if [ "$command" = "$file" ]; then
        $scripts_path/$uname/$command $@
        found=true
      fi
    done
  fi

  if $found; then
    return 0
  fi

  usage
  return 1
}
main $@
