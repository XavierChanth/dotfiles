(defcfg
  input  (iokit-name "Apple Internal Keyboard / Trackpad")
  output (kext)
  fallthrough true
)

(defsrc
  esc  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt spc  ralt rmet cmp  rctl
  fn   lft  down up   rght
)

;;(defalias
;;    sft_j
;;        (tap-hold-next-release 10 j
;;          (tap-next (tap-hold-next-release 150 j
;;            (layer-toggle repeat)) rsft))
;;)
(defalias
    fn (around (layer-toggle function) fn)
    lock (layer-switch void)

    voidfn (around (layer-toggle voidfn) fn)
    unlock (layer-switch default)

    caps (tap-hold-next-release 250 esc (around lctl (around lsft (around lalt lmet))))
    a (tap-hold-next-release 250 a lctl)
    s (tap-hold-next-release 250 s lsft)
    d (tap-hold-next-release 250 d lalt)
    f (tap-hold-next-release 250 f lmet)

    j j
    k k
    l l
    ; ;

    ;;j (tap-hold-next-release 250 j lmet)
    ;;k (tap-hold-next-release 250 k lsft)
    ;;l (tap-hold-next-release 250 l lctl)
    ;;; (tap-hold-next-release 250 ; lalt)

    ;;a
    ;;(tap-hold-next-release 10 a
    ;;  (tap-next (tap-hold-next-release 250 a
    ;;    (layer-toggle repeat)) lctl))
    ;;s
    ;;(tap-hold-next-release 10 s
    ;;  (tap-next (tap-hold-next-release 250 s
    ;;    (layer-toggle repeat)) lsft))
    ;;d
    ;;(tap-hold-next-release 10 d
    ;;  (tap-next (tap-hold-next-release 250 d
    ;;    (layer-toggle repeat)) lalt))
    ;;f
    ;;(tap-hold-next-release 10 f
    ;;  (tap-next (tap-hold-next-release 250 f
    ;;    (layer-toggle repeat)) lmet))
    ;;
    ;;j
    ;;(tap-hold-next-release 10 j
    ;;  (tap-next (tap-hold-next-release 250 j
    ;;    (layer-toggle repeat)) lmet))
    ;;k
    ;;(tap-hold-next-release 250 k
    ;;  (tap-next (tap-hold-next-release 10 k
    ;;    (layer-toggle repeat)) lalt))
    ;;l
    ;;(tap-hold-next-release 250 l
    ;;  (tap-next (tap-hold-next-release 10 l
    ;;    (layer-toggle repeat)) lsft))
    ;;;
    ;;(tap-hold-next-release 250 ;
    ;;  (tap-next (tap-hold-next-release 10 ;
    ;;    (layer-toggle repeat)) lctl))
)


(deflayer default
  esc brdn brup lp mctl bldn blup prev pp next mute vold volu
  _ _ _ _ _ _ _ _ _ _ _ _ _ _
  _ _ _ _ _ _ _ _ _ _ _ _ _ _
  @caps @a @s @d @f _ _ @j @k @l @; _ _
  _ _ _ _ _ _ _ _ _ _ _ _
  _ _ _ _ _ _ _ _
  @fn _ _ _ _
)

(deflayer repeat
  _ _ _ _ _ _ _ _ _ _ _ _ _
  _ _ _ _ _ _ _ _ _ _ _ _ _ _
  _ _ _ _ _ _ _ _ _ _ _ _ _ _
  _ a s d f _ _ j k l ; _ _
  _ _ _ _ _ _ _ _ _ _ _ _
  _ _ _ _ _ _ _ _
  @fn _ _ _ _
)

(deflayer function
  @lock f1 f2 f3 f4 f5 f6 f7 f8 f9 f10 f11 f12
  _ _ _ _ _ _ _ _ _ _ _ _ _ _
  _ _ _ _ _ _ _ _ _ _ _ _ _ _
  _ _ _ _ _ _ _ _ _ _ _ _ _
  _ _ _ _ _ _ _ _ _ _ _ _
  _ _ _ _ _ _ _ _
  _ _ _ _ _
)

(deflayer void
  XX XX XX XX XX XX XX XX XX XX XX XX XX
  XX XX XX XX XX XX XX XX XX XX XX XX XX XX
  XX XX XX XX XX XX XX XX XX XX XX XX XX XX
  XX XX XX XX XX XX XX XX XX XX XX XX XX
  XX XX XX XX XX XX XX XX XX XX XX XX
  XX XX XX XX XX XX XX XX
  @voidfn XX XX XX XX
)

(deflayer voidfn
  @unlock XX XX XX XX XX XX XX XX XX XX XX XX
  XX XX XX XX XX XX XX XX XX XX XX XX XX XX
  XX XX XX XX XX XX XX XX XX XX XX XX XX XX
  XX XX XX XX XX XX XX XX XX XX XX XX XX
  XX XX XX XX XX XX XX XX XX XX XX XX
  XX XX XX XX XX XX XX XX
  XX XX XX XX XX
)
