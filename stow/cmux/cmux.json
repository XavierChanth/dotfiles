{
  "$schema" : "https://raw.githubusercontent.com/manaflow-ai/cmux/main/web/data/cmux.schema.json",
  "actions" : {
    "ccx" : {
      "command" : "ccx",
      "icon" : {
        "name" : "bolt.fill",
        "type" : "symbol"
      },
      "target" : "newTabInCurrentPane",
      "title" : "CCX",
      "type" : "agent"
    },
    "claude" : {
      "command" : "claude",
      "icon" : {
        "name" : "sparkles",
        "type" : "symbol"
      },
      "target" : "newTabInCurrentPane",
      "title" : "Claude",
      "type" : "agent"
    },
    "codex" : {
      "command" : "codex",
      "icon" : {
        "name" : "chevron.left.forwardslash.chevron.right",
        "type" : "symbol"
      },
      "target" : "newTabInCurrentPane",
      "title" : "Codex",
      "type" : "agent"
    },
    "pi" : {
      "command" : "pi",
      "icon" : {
        "name" : "circle.hexagongrid",
        "type" : "symbol"
      },
      "target" : "newTabInCurrentPane",
      "title" : "Pi",
      "type" : "agent"
    }
  },
  "customSidebars" : {
    "renderer" : "inProcess"
  },
  "schemaVersion" : 1,
  "shortcuts" : {
    "bindings" : {
      "focusDown" : {
        "first" : {
          "command" : false,
          "control" : true,
          "key" : "j",
          "keyCode" : 38,
          "option" : false,
          "shift" : false
        }
      },
      "focusLeft" : {
        "first" : {
          "command" : false,
          "control" : true,
          "key" : "h",
          "keyCode" : 4,
          "option" : false,
          "shift" : false
        }
      },
      "focusRight" : {
        "first" : {
          "command" : false,
          "control" : true,
          "key" : "l",
          "keyCode" : 37,
          "option" : false,
          "shift" : false
        }
      },
      "focusUp" : {
        "first" : {
          "command" : false,
          "control" : true,
          "key" : "k",
          "keyCode" : 40,
          "option" : false,
          "shift" : false
        }
      }
    }
  },
  "ui" : {
    "surfaceTabBar" : {
      "buttons" : [
        "cmux.newTerminal",
        "cmux.newBrowser",
        "pi",
        "codex",
        "claude",
        "ccx"
      ]
    }
  }
}