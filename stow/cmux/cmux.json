{
  "$schema" : "https://raw.githubusercontent.com/manaflow-ai/cmux/main/web/data/cmux.schema.json",
  "actions" : {
    "ccx" : {
      "command" : "ccx",
      "icon" : {
        "name" : "bolt.fill",
        "type" : "symbol"
      },
      "target" : "newTabInCurrentPane",
      "title" : "CCX",
      "type" : "agent"
    },
    "claude" : {
      "command" : "claude",
      "icon" : {
        "name" : "sparkles",
        "type" : "symbol"
      },
      "target" : "newTabInCurrentPane",
      "title" : "Claude",
      "type" : "agent"
    },
    "codex" : {
      "command" : "codex",
      "icon" : {
        "name" : "chevron.left.forwardslash.chevron.right",
        "type" : "symbol"
      },
      "target" : "newTabInCurrentPane",
      "title" : "Codex",
      "type" : "agent"
    },
    "pi" : {
      "command" : "pi",
      "icon" : {
        "name" : "circle.hexagongrid",
        "type" : "symbol"
      },
      "target" : "newTabInCurrentPane",
      "title" : "Pi",
      "type" : "agent"
    }
  },
  "customSidebars" : {
    "renderer" : "inProcess"
  },
  "schemaVersion" : 1,
  "shortcuts" : {
    "bindings" : {
      "commandPalette" : "cmd+ctrl+alt+shift+space",
      "equalizeSplits" : "cmd+ctrl+alt+shift+equal",
      "focusDown" : "cmd+ctrl+alt+shift+j",
      "focusLeft" : "cmd+ctrl+alt+shift+h",
      "focusRight" : "cmd+ctrl+alt+shift+l",
      "focusUp" : "cmd+ctrl+alt+shift+k",
      "splitDown" : "cmd+ctrl+alt+shift+minus",
      "splitRight" : "cmd+ctrl+alt+shift+backslash",
      "toggleSplitZoom" : "cmd+ctrl+alt+shift+f"
    }
  },
  "ui" : {
    "surfaceTabBar" : {
      "buttons" : [
        "cmux.newTerminal",
        "cmux.newBrowser",
        "pi",
        "codex",
        "claude",
        "ccx"
      ]
    }
  }
}