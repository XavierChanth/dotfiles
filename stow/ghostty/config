# styling
# config-file = colorscheme

theme = "light:Flexoki Light,dark:tokyonight-storm"

font-family = "CommitMono Nerd Font"
font-feature= +cv07,+ss03,+ss04,+ss05
# ligatures ss01, arrows ss02
font-size = 13
adjust-cell-height = 20%


window-padding-balance = true
background-opacity = 0.95
background-blur-radius = 20

# behaviour

title = "Ghostty"
command = "tmux new -A -s main"

confirm-close-surface = false
quit-after-last-window-closed = true
link-url = true
app-notifications = no-clipboard-copy

# mouse behaviour
mouse-hide-while-typing = true
mouse-shift-capture = false

# keybinds

macos-option-as-alt = true

keybind = ctrl+shift+t=unbind
keybind = super+r=reload_config
keybind = super+j=text:5j
keybind = super+k=text:5k

config-file = tmux-binds
