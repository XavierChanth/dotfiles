// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    // Global Navigation Binds
    "bindings": {
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-alt-cmd-shift-c": "workspace::NewCenterTerminal",
      "ctrl-alt-cmd-shift-n": "workspace::NewFile",
      "ctrl-alt-cmd-shift-g": "git::Diff",
    },
  },
  {
    // keep Enter aligned with Shift-Enter while composing in the Agent chat editor
    "context": "AcpThread > Editor && vim_mode == insert",
    "bindings": {
      "enter": ["workspace::SendKeystrokes", "shift-enter"],
    },
  },
  {
    // whole file text object with ag
    "context": "vim_mode == visual",
    "bindings": {
      "a g": "editor::SelectAll",
    },
  },
  {
    "context": "vim_mode == operator && vim_operator == y",
    "bindings": {
      "a g": [
        "action::Sequence",
        ["editor::SelectAll", "editor::Copy", "vim::NormalBefore"],
      ],
    },
  },
  {
    "context": "vim_mode == operator && vim_operator == d",
    "bindings": {
      "a g": [
        "action::Sequence",
        ["editor::SelectAll", "editor::Cut", "vim::SwitchToNormalMode"],
      ],
    },
  },
  {
    "context": "vim_mode == operator && vim_operator == c",
    "bindings": {
      "a g": [
        "action::Sequence",
        ["editor::SelectAll", "editor::Cut", "vim::SwitchToInsertMode"],
      ],
    },
  },
]
