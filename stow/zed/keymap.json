// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    // Global Navigation Binds
    "bindings": {
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-alt-cmd-shift-c": "workspace::NewCenterTerminal",
      "ctrl-alt-cmd-shift-n": "workspace::NewFile",
      "ctrl-alt-cmd-shift-g": "git::Diff",
      "ctrl-alt-cmd-shift-e": "vim::ToggleProjectPanelFocus",
      "ctrl-alt-cmd-shift-a": "agent::ToggleFocus",
    },
  },
  {
    // whole file text object with ag
    "context": "vim_mode == visual",
    "bindings": {
      ">": ["workspace::SendKeystrokes", "> g v"],
      "<": ["workspace::SendKeystrokes", "< g v"],
    },
  },
  {
    // Move by visual lines in normal mode.
    "context": "vim_mode == normal && !menu",
    "bindings": {
      "j": ["workspace::SendKeystrokes", "g j"],
      "k": ["workspace::SendKeystrokes", "g k"],
    },
  },
  {
    // Queries for quotes/brackets/file
    "context": "vim_operator == a || vim_operator == i",
    "bindings": {
      "q": "vim::MiniQuotes",
      "b": "vim::MiniBrackets",
      "g": "vim::EntireFile",
    },
  },
  {
    // keep Enter aligned with Shift-Enter while composing in the Agent chat editor
    "context": "AcpThread > Editor && vim_mode == insert",
    "bindings": {
      "enter": ["workspace::SendKeystrokes", "shift-enter"],
    },
  },
]
