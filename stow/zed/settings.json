{
  "diff_view_style": "unified",
  "use_auto_surround": false,
  "use_autoclose": false,
  "ui_font_family": "Helvetica Neue",
  "edit_predictions": {
    "provider": "copilot",
    "mode": "subtle",
  },
  "show_edit_predictions": true,

  "command_aliases": {
    "w": "workspace::Save",
    "W": "workspace::SaveWithoutFormat",
    "wa": "workspace::SaveAll",
  },
  "use_system_window_tabs": true,
  "debugger": {
    "button": true,
  },
  "terminal": {
    "toolbar": {
      "breadcrumbs": true,
    },
    "button": true,
    "env": {
      "EDITOR": "zed -w",
      "VISUAL": "zed -w",
    },
  },
  "project_panel": {
    "button": true,
  },
  "agent_servers": {
    "codex-acp": {
      "type": "registry",
    },
    "pi-acp": {
      "favorite_models": [
        "openai-codex/gpt-5.4",
        "openai-codex/gpt-5.4-mini",
        "opencode-go/minimax-m2.7",
        "opencode-go/kimi-k2.6",
      ],
      "type": "registry",
    },
  },
  "tab_bar": {
    "show_pinned_tabs_in_separate_row": true,
    "show_tab_bar_buttons": true,
    "show_nav_history_buttons": false,
  },
  "git": {
    "blame": {
      "show_avatar": true,
    },
  },
  "proxy": "",
  "agent": {
    "expand_edit_card": true,
    "favorite_models": [],
    "model_parameters": [],
  },
  "calls": {
    "mute_on_join": true,
  },
  "tabs": {
    "file_icons": false,
    "close_position": "right",
    "git_status": false,
  },
  "title_bar": {
    "show_user_menu": true,
    "show_menus": false,
    "show_onboarding_banner": false,
    "show_project_items": true,
    "show_user_picture": true,
    "show_sign_in": false,
    "show_branch_name": false,
    "show_branch_status_icon": false,
  },
  "status_bar": {
    "cursor_position_button": true,
    "show_active_file": true,
  },
  "seed_search_query_from_cursor": "never",
  "search": {
    "button": true,
    "regex": true,
  },
  "diagnostics": {
    "button": true,
    "inline": {
      "enabled": true,
    },
  },
  "prettier": {
    "allowed": true,
  },
  "document_symbols": "on",
  "document_folding_ranges": "on",
  "semantic_tokens": "combined",
  "vim_mode": true,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark",
  },
  "auto_update": false,
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "restore_on_startup": "launchpad",
  "redact_private_values": true,
  "on_last_window_closed": "quit_app",
  "when_closing_with_no_tabs": "close_window",
  "buffer_font_family": "CommitMono Nerd Font Mono",
  "wrap_guides": [80, 120],
}
