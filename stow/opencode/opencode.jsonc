{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "lsp": false,
  "formatter": false,
  "plugins": [
    {
      "package": "./plugins/reviewer.ts",
      "options": {
        "models": [
          {
            "provider": "openai",
            "model": "gpt-5.6-luna",
            "effort": "high",
          },
        ],
        "timeoutMs": 90000,
      },
    },
  ],
}
