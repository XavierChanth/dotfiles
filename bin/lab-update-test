#!/usr/bin/env bash
# shellcheck disable=SC2016
set -Eeuo pipefail
cd "$(dirname "$0")/.."
SCRIPT=bin/lab-update
fail() { echo "FAIL: $*" >&2; exit 1; }
has() { grep -Fq -- "$1" "$SCRIPT" || fail "missing: $1"; }

bash -n "$SCRIPT"
shellcheck "$SCRIPT"

# Dry-run must not even invoke an ssh found on PATH, and its ordering is contractual.
t=$(mktemp -d); trap 'rm -rf "$t"' EXIT
cat >"$t/ssh" <<'EOF'
#!/bin/sh
echo contacted >"${LAB_UPDATE_SSH_MARKER:?}"
exit 99
EOF
chmod +x "$t/ssh"
LAB_UPDATE_SSH_MARKER=$t/contacted PATH="$t:$PATH" "$SCRIPT" --dry-run hades >"$t/plan"
[[ ! -e $t/contacted ]] || fail "dry-run contacted ssh"
awk '/^phase: / {sub(/^phase: /, ""); print}' "$t/plan" >"$t/phases"
diff -u - "$t/phases" <<'EOF'
snapshot tracked source
read-only remote preflight
confirm staging
validate and stage unique remote tree
one target-local build
inspect exact closure
confirm activation
start bounded sleep inhibitor
arm 15-minute dead-man reboot
detached test activation
observe test result and postflight over fresh SSH
re-arm dead-man
detached boot commit
observe commit result and verify profile
cancel dead-man last
optional attended reboot
EOF

# Focused structural regressions for safety properties whose commands must run remotely.
has 'ControlMaster=no'; has 'ControlPath=none'; has 'ServerAliveInterval=5'; has 'ServerAliveCountMax=3'
has 'baseline=${2-}'
has 'Result --value'; has 'ExecMainStatus --value'
has 'remote returned an unsafe staging path'
has '^/var/tmp/lab-update\.[A-Za-z0-9]{8}$'
has "jj file list -T 'path ++ \"\\0\"'"
has 'Git fallback refuses untracked files'
has '--no-write-lock-file'
has "Type 'activate \$HOST'"

# Cancellation follows commit launch, result/profile verification, and the armed-failure guard.
commit=$(grep -n 'unit=lab-update-commit' "$SCRIPT" | cut -d: -f1)
profile=$(grep -n 'readlink -f /nix/var/nix/profiles/system' "$SCRIPT" | tail -1 | cut -d: -f1)
cancel=$(grep -n "ssh_host 'sudo -n shutdown -c'" "$SCRIPT" | cut -d: -f1)
[[ $commit -lt $profile && $profile -lt $cancel ]] || fail "unsafe commit/cancel ordering"
[[ $(grep -c "shutdown -c" "$SCRIPT") == 1 ]] || fail "shutdown cancellation must have one guarded site"

# Prove this jj version emits a NUL-safe tracked manifest and a stable identity.
jj root >/dev/null
jj file list -T 'path ++ "\0"' >"$t/jj-files"
[[ -s $t/jj-files && $(tr -cd '\0' <"$t/jj-files" | wc -c) -gt 0 ]] || fail "jj manifest is not NUL-delimited"
[[ -n $(jj log --no-graph -r @ -T 'commit_id') ]] || fail "jj identity empty"

# With jj unavailable, an untracked Git file aborts before SSH or snapshotting.
mkdir "$t/fake-git-root"
cat >"$t/git" <<EOF
#!/bin/sh
case "\$*" in
  'rev-parse --show-toplevel') echo '$t/fake-git-root' ;;
  'ls-files --others --exclude-standard') echo secret-untracked ;;
  *) exit 2 ;;
esac
EOF
chmod +x "$t/git"
rm -f "$t/contacted"
if LAB_UPDATE_SSH_MARKER=$t/contacted PATH="$t:/usr/bin:/bin" "$SCRIPT" hades >"$t/git.out" 2>"$t/git.err"; then
  fail "Git fallback accepted untracked file"
fi
grep -Fq 'Git fallback refuses untracked files' "$t/git.err" || fail "wrong Git fallback failure"
[[ ! -e $t/contacted ]] || fail "Git rejection contacted ssh"

# Execute the attended path against a stateful fake SSH. This checks actual command
# ordering and the fail-closed cancellation rule without contacting any host.
cat >"$t/ssh" <<'EOF'
#!/usr/bin/env bash
set -eu
printf '%s\n' "$*" >>"${FAKE_SSH_LOG:?}"
cmd=$*
case $cmd in
  *print-out-paths*) echo /nix/store/fake-system ;;
  *mktemp*lab-update*) echo /var/tmp/lab-update.A1b2C3d4 ;;
  *lab-update-test*RemainAfterExit=yes*)
    [[ ${FAKE_SSH_FAIL_TEST:-0} == 0 ]] || exit 1 ;;
  *bash*-se* )
    if [[ ! -e ${FAKE_SSH_PREFLIGHT:?} ]]; then
      : >"$FAKE_SSH_PREFLIGHT"
      cat <<'OUT'
identity host=hades os=nixos arch=x86_64 user=test
closures current=/nix/store/old booted=/nix/store/old profile=/nix/store/old
FAILED=
OUT
    fi ;;
esac
# Consume the archive stream so the producer cannot see a misleading SIGPIPE.
case $cmd in *tar*'-xf'*) cat >/dev/null || true ;; esac
EOF
chmod +x "$t/ssh"
run_fake() {
  rm -f "$t/ssh.log" "$t/preflight"
  printf 'update hades\nactivate hades\n\n\n' |
    FAKE_SSH_LOG="$t/ssh.log" FAKE_SSH_PREFLIGHT="$t/preflight" \
    PATH="$t:$PATH" "$SCRIPT" hades >"$t/fake.out" 2>"$t/fake.err"
}
run_fake || { cat "$t/fake.out" >&2; cat "$t/fake.err" >&2; fail "fake SSH success path failed"; }
line() { grep -n -F -- "$1" "$t/ssh.log" | head -1 | cut -d: -f1; }
test_launch=$(grep -n 'lab-update-test.*RemainAfterExit=yes' "$t/ssh.log" | head -1 | cut -d: -f1)
rearm=$(grep -n 'lab-update.*commit.*dead-man.*reboot' "$t/ssh.log" | cut -d: -f1)
commit_launch=$(grep -n 'lab-update-commit.*RemainAfterExit=yes' "$t/ssh.log" | head -1 | cut -d: -f1)
cancel_line=$(grep -n 'shutdown.*-c' "$t/ssh.log" | head -1 | cut -d: -f1)
[[ $test_launch -lt $rearm && $rearm -lt $commit_launch && $commit_launch -lt $cancel_line ]] ||
  fail "fake SSH observed unsafe ordering"
[[ $(grep -c 'shutdown.*-c' "$t/ssh.log") == 1 ]] || fail "fake path did not cancel exactly once"
grep -Fq 'RemainAfterExit=yes' "$t/ssh.log" || fail "transient result was not retained"
grep -Eq '/run/current-system/sw/bin/timeout.*25' "$t/ssh.log" || fail "remote checks lack timeout"

rm -f "$t/ssh.log" "$t/preflight"
if printf 'update hades\nactivate hades\n' | FAKE_SSH_FAIL_TEST=1 FAKE_SSH_LOG="$t/ssh.log" \
  FAKE_SSH_PREFLIGHT="$t/preflight" PATH="$t:$PATH" "$SCRIPT" hades >"$t/fail.out" 2>"$t/fail.err"; then
  fail "injected test-launch failure succeeded"
fi
! grep -Eq 'shutdown.*-c' "$t/ssh.log" || fail "injected failure cancelled dead-man"
! grep -Eq 'lab-update-commit.*RemainAfterExit=yes' "$t/ssh.log" || fail "commit ran after test failure"

# The two archive contracts are explicit; deterministic claims are GNU-only.
has 'ARCHIVE_MODE=gnu-tar-deterministic'
has 'ARCHIVE_MODE=bsdtar-integrity-only'
has 'bsdtar integrity-only mode (content hash, metadata not normalized)'
has 'archive_mode=%s'

echo 'lab-update local regressions: PASS'
