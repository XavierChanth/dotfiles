#!/usr/bin/env bash
# shellcheck disable=SC2016
set -Eeuo pipefail
IFS=$'\n\t'
(( BASH_VERSINFO[0] >= 5 )) || { echo 'lab-update: Bash 5 is required' >&2; exit 1; }
die() { echo "lab-update: $*" >&2; exit 1; }
usage() { echo "usage: $0 [--dry-run] hades" >&2; }
DRY_RUN=0
[[ ${1:-} != --dry-run ]] || { DRY_RUN=1; shift; }
[[ $# == 1 ]] || { usage; exit 64; }
HOST=$1; [[ $HOST == hades ]] || die "unsupported host: $HOST"
SSH=(ssh -o BatchMode=yes -o ControlMaster=no -o ControlPath=none -o ConnectTimeout=10 -o ServerAliveInterval=5 -o ServerAliveCountMax=3)
phases=("snapshot tracked source" "unprivileged remote preflight" "confirm staging" "unprivileged private staging" "unprivileged target-local build" "unprivileged closure inspection" "confirm activation" "one attended PTY sudo rollout" "unprivileged bounded rollout observation" "optional attended reboot")
if (( DRY_RUN )); then
  echo 'DRY RUN: no SSH or network calls will be made'; printf 'host: %s\n' "$HOST"; printf 'phase: %s\n' "${phases[@]}"; exit
fi
for c in ssh tar shasum jj; do command -v "$c" >/dev/null || die "$c is required"; done
T=$(mktemp -d "${TMPDIR:-/tmp}/lab-update.XXXXXX"); trap 'rm -rf "$T"' EXIT
ROOT=$(jj root) || die 'not in a jj workspace'; cd "$ROOT"
jj file list -T 'path ++ "\0"' | LC_ALL=C sort -z >"$T/list"
[[ -s $T/list ]] || die 'empty source manifest'
if tar --version 2>/dev/null | grep -q 'GNU tar'; then
  tar --format=ustar --owner=0 --group=0 --numeric-owner --mtime='UTC 1970-01-01' --sort=name --no-recursion -cf "$T/source.tar" --null -T "$T/list"
else
  COPYFILE_DISABLE=1 tar --no-xattrs --no-acls --no-fflags -cf "$T/source.tar" --null -T "$T/list"
fi
cat >"$T/driver" <<'DRIVER'
#!/usr/bin/env bash
set -Eeuo pipefail
(( BASH_VERSINFO[0] >= 5 )) || { echo 'rollout driver: Bash 5 is required' >&2; exit 69; }
closure=$1 baseline=${2-}
[[ $baseline != __LAB_UPDATE_EMPTY__ ]] || baseline=
[[ $closure =~ ^/nix/store/[a-z0-9]{32}-[A-Za-z0-9._+?=-]+$ ]] || exit 64
old=$(readlink -f /nix/var/nix/profiles/system)
mutated=0 success=0
finish() {
  rc=$?
  trap - EXIT
  if (( ! success && mutated )); then
    # RuntimeMaxSec leaves TimeoutStopSec for these bounded recovery operations.
    timeout 60 nix-env -p /nix/var/nix/profiles/system --set "$old" || true
    timeout 60 "$old/bin/switch-to-configuration" boot || true
  fi
  rm -f -- /run/lab-update-driver
  exit "$rc"
}
trap finish EXIT TERM INT HUP
# Refuse to inherit stale rollout state and replace only our bounded inhibitor.
systemctl stop lab-update-inhibit.service 2>/dev/null || true
systemctl reset-failed lab-update-inhibit.service 2>/dev/null || true
systemd-run --unit=lab-update-inhibit --collect systemd-inhibit --what=sleep --why=lab-update --mode=block /run/current-system/sw/bin/sleep 1200
shutdown -r +15 'lab-update dead-man reboot'
"$closure/bin/switch-to-configuration" test
[[ $(readlink -f /run/current-system) == "$closure" ]]
now=$(systemctl --failed --no-legend --plain | awk '{print $1}' | LC_ALL=C sort | paste -sd, -)
[[ $now == "$baseline" ]]
getent ahosts cache.nixos.org >/dev/null
findmnt / >/dev/null
if grep -Eq '[[:space:]]/boot[[:space:]]' "$closure/etc/fstab"; then findmnt /boot >/dev/null; fi
for u in sshd.service tailscaled.service NetworkManager.service display-manager.service; do systemctl is-active --quiet "$u"; done
for u in sleep.target suspend.target hibernate.target hybrid-sleep.target; do [[ $(systemctl is-enabled "$u" 2>/dev/null) == masked ]]; done
shutdown -r +15 'lab-update commit dead-man reboot'
nix-env -p /nix/var/nix/profiles/system --set "$closure"; mutated=1
"$closure/bin/switch-to-configuration" boot
[[ $(readlink -f /nix/var/nix/profiles/system) == "$closure" ]]
[[ $(readlink -f /run/current-system) == "$closure" ]]
shutdown -c
success=1
systemctl stop lab-update-inhibit.service || true
DRIVER
chmod 700 "$T/driver"
DRIVER_SHA=$(shasum -a 256 "$T/driver" | awk '{print $1}')

# Every data-bearing and observational connection is non-PTY and unprivileged.
PRE=$("${SSH[@]}" "$HOST" 'bash -s' <<'REMOTE'
set -Eeuo pipefail
[[ $(uname -s) == Linux && -e /etc/NIXOS ]]
u=$(id -un); id -nG "$u" | tr ' ' '\n' | grep -qx wheel
status=$(passwd -S "$u"); set -- $status; [[ ${2:-} == P ]]
current=$(readlink -f /run/current-system); booted=$(readlink -f /run/booted-system); profile=$(readlink -f /nix/var/nix/profiles/system)
[[ $current == "$booted" && $current == "$profile" ]]
printf 'CURRENT=%s\nBOOTED=%s\nPROFILE=%s\n' "$current" "$booted" "$profile"
printf 'FAILED='; systemctl --failed --no-legend --plain | awk '{print $1}' | LC_ALL=C sort | paste -sd, -
REMOTE
) || die 'preflight failed (wheel membership and a real password are required)'
printf '%s\n' "$PRE"; BASE_FAILED=$(sed -n 's/^FAILED=//p' <<<"$PRE")
[[ $BASE_FAILED =~ ^[A-Za-z0-9@_.:,~-]*$ ]] || die 'unsafe failed-unit baseline'
read -r -p "Type 'update $HOST' to stage and build: " a; [[ $a == "update $HOST" ]] || die 'not confirmed'
REMOTE_DIR=$("${SSH[@]}" "$HOST" 'umask 077; d=$(mktemp -d /var/tmp/lab-update.XXXXXXXX); printf "%s\n" "$d"')
[[ $REMOTE_DIR =~ ^/var/tmp/lab-update\.[A-Za-z0-9]{8}$ ]] || die 'unsafe staging path'
cleanup() { "${SSH[@]}" "$HOST" "rm -rf -- $REMOTE_DIR" >/dev/null 2>&1 || true; rm -rf "$T"; }; trap cleanup EXIT
"${SSH[@]}" "$HOST" "tar --no-same-owner -xf - -C $REMOTE_DIR" <"$T/source.tar"
"${SSH[@]}" "$HOST" "cat >$REMOTE_DIR/rollout-driver && chmod 0700 $REMOTE_DIR/rollout-driver" <"$T/driver"
REMOTE_SHA=$("${SSH[@]}" "$HOST" "sha256sum $REMOTE_DIR/rollout-driver" | awk '{print $1}')
[[ $REMOTE_SHA == "$DRIVER_SHA" ]] || die 'staged driver hash mismatch'
BUILD=$("${SSH[@]}" "$HOST" "nix build --no-link --no-write-lock-file --print-out-paths --builders '' $REMOTE_DIR#nixosConfigurations.$HOST.config.system.build.toplevel") || die 'build failed'
mapfile -t paths < <(grep '^/nix/store/' <<<"$BUILD"); [[ ${#paths[@]} == 1 ]] || die 'expected one closure'; CLOSURE=${paths[0]}
[[ $CLOSURE =~ ^/nix/store/[a-z0-9]{32}-[A-Za-z0-9._+?=-]+$ ]] || die 'unsafe closure path'
"${SSH[@]}" "$HOST" "nix path-info $CLOSURE >/dev/null && test -x $CLOSURE/bin/switch-to-configuration && nix store diff-closures \$(readlink -f /run/current-system) $CLOSURE && test -r $CLOSURE/etc/ssh/sshd_config && $CLOSURE/sw/bin/sshd -t -f $CLOSURE/etc/ssh/sshd_config && test -r $CLOSURE/etc/fstab && findmnt --verify --tab-file $CLOSURE/etc/fstab && awk '\$2==\"/\"{ok=1} END{exit !ok}' $CLOSURE/etc/fstab && ! findmnt -nro OPTIONS /boot 2>/dev/null | grep -qw ro"
read -r -p "Type 'activate $HOST' to start the rollback-protected rollout: " a; [[ $a == "activate $HOST" ]] || die 'activation not confirmed'
[[ -t 0 ]] || die 'the attended privileged phase requires a local stdin TTY'
# Exactly one data-free attended connection. sudo reads the password directly from its TTY.
# Encode empty distinctly so argv[2] is present through both remote-shell layers.
if [[ -z $BASE_FAILED ]]; then qbase=__LAB_UPDATE_EMPTY__; else printf -v qbase '%q' "$BASE_FAILED"; fi
PTY_CMD="sudo /bin/sh -ceu 'test \"\$(sha256sum $REMOTE_DIR/rollout-driver | awk \"{print \\\$1}\")\" = $DRIVER_SHA; systemctl stop lab-update-rollout.service 2>/dev/null || true; systemctl reset-failed lab-update-rollout.service 2>/dev/null || true; install -o root -g root -m 0500 $REMOTE_DIR/rollout-driver /run/lab-update-driver; test \"\$(stat -c %U:%G:%a /run/lab-update-driver)\" = root:root:500; test \"\$(sha256sum /run/lab-update-driver | awk \"{print \\\$1}\")\" = $DRIVER_SHA; systemd-run --unit=lab-update-rollout --property=RemainAfterExit=yes --property=RuntimeMaxSec=720 --property=TimeoutStopSec=130 --no-block /run/lab-update-driver $CLOSURE $qbase'"
"${SSH[@]}" -tt "$HOST" "$PTY_CMD" || die 'rollout launch failed; an armed reboot may remain pending (rollback is not guaranteed)'
# Fresh, bounded, non-privileged observations. Retained status is removed only by a later rollout.
deadline=$((SECONDS+900)); observed=0
while (( SECONDS < deadline )); do
  out=$("${SSH[@]}" "$HOST" "timeout 25 sh -c 'systemctl show lab-update-rollout.service -p LoadState -p ActiveState -p SubState -p Result -p ExecMainStatus --value; readlink -f /run/current-system; readlink -f /nix/var/nix/profiles/system'" 2>/dev/null) || { sleep 5; continue; }
  mapfile -t state <<<"$out"
  ((${#state[@]} >= 7)) || die 'rollout unit returned incomplete state'
  load=${state[0]}; active=${state[1]}; sub=${state[2]}; result=${state[3]}; status=${state[4]}; current=${state[5]}; profile=${state[6]}
  [[ $load == loaded ]] || die 'rollout unit is unknown or collected; dead-man may remain armed'
  if [[ $active == failed || $result == failed || ( $status =~ ^[0-9]+$ && $status != 0 ) ]]; then die 'rollout failed; dead-man may remain armed'; fi
  if [[ $active == active && $sub == exited && $result == success && $status == 0 ]]; then
    [[ $current == "$CLOSURE" && $profile == "$CLOSURE" ]] || die 'rollout terminal state has wrong closure/profile; dead-man may remain armed'
    observed=1; echo "rollout succeeded: $CLOSURE"; break
  fi
  sleep 5
done
(( observed )) || die 'rollout observation timed out; dead-man may remain armed'
read -r -p "Type 'reboot $HOST' for an attended reboot, or Enter to finish: " a
if [[ $a == "reboot $HOST" ]]; then "${SSH[@]}" -tt "$HOST" 'sudo systemctl reboot' || echo 'reboot requested; SSH disconnected during reboot' >&2; fi
